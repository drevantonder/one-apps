<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- What macOS shows where it asks for a permission, and in Privacy & Security, under the helper's name. -->
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key><string>app.theone.mac-helper</string>
  <key>CFBundleName</key><string>The One App Helper</string>
  <key>CFBundleExecutable</key><string>helper</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>1.0</string>
  <key>LSBackgroundOnly</key><true/>
  <key>NSCalendarsFullAccessUsageDescription</key><string>Your apps and agents read and change your calendars through this Mac.</string>
  <key>NSRemindersFullAccessUsageDescription</key><string>Your apps and agents read and change your reminders through this Mac.</string>
  <key>NSContactsUsageDescription</key><string>Your apps and agents find people in your contacts, and messages show who they're from.</string>
  <key>NSAppleEventsUsageDescription</key><string>Your agents send the iMessages you ask them to through Messages on this Mac.</string>
</dict>
</plist>
